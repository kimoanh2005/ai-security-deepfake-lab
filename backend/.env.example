# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=120
HEAVY_RATE_LIMIT_PER_MINUTE=10
MAX_QUEUED_JOBS=20
DB_PATH=./storage/lab.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama chạy trên Google Colab (SPEC D-18). Địa chỉ đường hầm đổi mỗi phiên Colab.
# Để trống OLLAMA_URL khi chưa bật Colab: Lab Prompt Injection sẽ báo chưa sẵn sàng.
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_ALLOWED_HOSTS=trycloudflare.com,ngrok-free.app
OLLAMA_MODEL=security-bot
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# Sandbox /sandbox/echo (đối tượng bị thử của Lab API Security). Chỉ loopback.
# SANDBOX_TOKEN để trống = tự sinh ngẫu nhiên mỗi lần khởi động. start.ps1 -Port tự cập nhật SANDBOX_BASE_URL.
SANDBOX_TOKEN=
SANDBOX_BASE_URL=http://127.0.0.1:8000
SANDBOX_WINDOW_SECONDS=10
SANDBOX_MAX_REQUESTS=20
MAX_API_LAB_REQUESTS=100

# Trần cứng cho các Lab (giá trị khởi đầu, cần đo trên máy thật).
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=60
FFPROBE_TIMEOUT=10
MAX_FRAMES=24
MAX_PI_CALLS=60
MAX_EVENTS_PER_EXPERIMENT=200
MAX_RESULT_BYTES=262144

# Thời gian tối đa một job (giây); quá hạn thì experiment `failed` (FR-EXP-05). Cần đo trên máy thật.
# Lab nào không đặt JOB_TIMEOUT_<LAB> (bỏ dấu # để dùng) thì lấy JOB_TIMEOUT_DEFAULT. Không để trống giá trị.
JOB_TIMEOUT_DEFAULT=120
# JOB_TIMEOUT_DEEPFAKE=300
JOB_TIMEOUT_PROMPT_INJECTION=900
# JOB_TIMEOUT_API_LAB=120
# JOB_TIMEOUT_POISONING=120

# Chỉ dùng cho `python -m app.seed` (không bắt buộc). Bỏ trống mật khẩu thì seed sinh ngẫu nhiên và in một lần.
SEED_ADMIN_EMAIL=admin@lab.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@lab.local
SEED_USER_PASSWORD=
