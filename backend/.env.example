# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
DB_PATH=./storage/lab.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama chạy trên Google Colab (SPEC D-18). Địa chỉ đường hầm đổi mỗi phiên Colab.
# Để trống OLLAMA_URL khi chưa bật Colab: Lab Prompt Injection sẽ báo chưa sẵn sàng.
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_ALLOWED_HOSTS=trycloudflare.com,ngrok-free.app
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# Chỉ dùng cho `python -m app.seed` (không bắt buộc). Bỏ trống mật khẩu thì seed sinh ngẫu nhiên và in một lần.
SEED_ADMIN_EMAIL=admin@lab.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@lab.local
SEED_USER_PASSWORD=
